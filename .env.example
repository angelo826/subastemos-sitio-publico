# ── Sitio ────────────────────────────────────────────────────────────────
# Dominio canónico. Se usa en canonical, og:url, sitemap.xml y JSON-LD.
# Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# Clave de Google Maps JS API. Se usa en /contacto y /patios/*.
# OJO: la clave del clon estático es pública y debe rotarse antes de producción.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ── Backend (aún no integrado; ver docs/BACKEND.md) ──────────────────────
# URL base de los endpoints públicos de la app de producción.
# Variable DE SERVIDOR: sin prefijo NEXT_PUBLIC_, nunca llega al navegador.
BACKEND_API_URL=

# Credencial para el backend, si sus endpoints la requieren.
# En producción viene de Secret Manager, no de app.yaml.
BACKEND_API_KEY=

# Token que protege POST /api/revalidate.
REVALIDATE_TOKEN=

# Provider de datos activo: "static" (data/*.ts) o "api" (backend).
# Ver lib/repositories/index.ts
DATA_PROVIDER=static
